  "page_settings": {
    "custom_css": "/* ===== Archivo Habla Deportes — CSS de la plantilla ===== */\n\n/* 1. Rejilla intermedia: 2 columnas desde 520 px.\n   Elementor solo expone los cortes Tablet (<=1024) y Movil (<=767); este\n   bloque cubre la franja 520-767 px que el prototipo si contempla. */\n@media (min-width: 520px) and (max-width: 767px) {\n\t.hd-archive-grid .elementor-posts-container.elementor-grid {\n\t\tgrid-template-columns: repeat(2, 1fr);\n\t}\n}\n\n/* 2. La fecha va ENCIMA del titulo.\n   El skin Classic imprime el orden titulo -> meta; lo invertimos con flex\n   en lugar de tocar el markup. */\n.hd-archive-grid .elementor-post__text {\n\tdisplay: flex;\n\tflex-direction: column;\n}\n.hd-archive-grid .elementor-post__meta-data { order: -1; margin-top: 0; }\n.hd-archive-grid .elementor-post__title { order: 0; }\n\n/* 3. Titulo a 2 lineas maximo + hover naranja de marca. */\n.hd-archive-grid .elementor-post__title {\n\tdisplay: -webkit-box;\n\t-webkit-line-clamp: 2;\n\t-webkit-box-orient: vertical;\n\toverflow: hidden;\n}\n.hd-archive-grid .elementor-post__title a { transition: color .2s ease; }\n.hd-archive-grid .elementor-post:hover .elementor-post__title a { color: #E36209; }\n\n/* 4. La miniatura recorta en 16:9 sin deformar la imagen. */\n.hd-archive-grid .elementor-post__thumbnail img { object-fit: cover; }\n\n/* 5. Bajada del hero: medida de lectura comoda (no mas de ~62 caracteres). */\n.hd-archive-lede { max-width: 62ch; }\n\n/* 6. Paginacion: area tactil minima en cada numero. */\n.hd-archive-grid .elementor-pagination .page-numbers {\n\tdisplay: inline-block;\n\tmin-width: 34px;\n\tpadding: 6px 4px;\n}\n\n/* 7. Mensaje \"sin resultados\" centrado dentro del ancho de contenido. */\n.hd-archive-grid .elementor-posts-nothing-found {\n\tpadding: 48px 0;\n\ttext-align: center;\n}\n"
  },
