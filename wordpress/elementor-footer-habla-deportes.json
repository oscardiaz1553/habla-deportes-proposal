  "version": "0.4",
  "page_settings": {
    "custom_css": "/* ===== Footer Habla Deportes — CSS de la plantilla ===== */\n\n/* 1. Grilla de 4 columnas.\n   El control \"Columnas\" del contenedor grid ya lleva la unidad Personalizada\n   con estos mismos valores; este bloque es la red de seguridad por si la\n   unidad no se serializa al importar. Sin !important: si el control funciona,\n   manda el control. */\n.hd-footer.hd-footer-grid {\n\t--e-con-grid-template-columns: 1.6fr 1fr 1fr 1.2fr;\n\t--e-con-grid-template-rows: auto;\n}\n@media (max-width: 1023px) {\n\t.hd-footer.hd-footer-grid { --e-con-grid-template-columns: 1.4fr 1fr 1fr; }\n}\n@media (max-width: 767px) {\n\t.hd-footer.hd-footer-grid { --e-con-grid-template-columns: 1fr; }\n}\n\n/* 2. Franja inferior: la línea separadora debe medir lo mismo que el\n   contenido (1280 px), no todo el ancho de la pantalla. Por eso va sobre\n   .e-con-inner y no sobre el contenedor. */\n.hd-footer-bottom > .e-con-inner {\n\tborder-top: 1px solid rgba(255, 255, 255, .15);\n\tpadding-block: 20px;\n}\n\n/* 3. Enlaces del footer (cualquiera que no venga de la lista de iconos). */\n.hd-footer a,\n.hd-footer-bottom a { color: rgba(255, 255, 255, .72); }\n.hd-footer a:hover,\n.hd-footer-bottom a:hover { color: #FFFFFF; }\n\n/* 4. La bajada de marca no debe pasar de ~34 caracteres por línea. */\n.hd-footer-tagline { max-width: 34ch; }\n\n/* 5. Iconos sociales: sin fondo ni borde, solo el glifo en blanco. */\n.hd-footer-social .elementor-social-icon {\n\tbackground-color: transparent;\n\tborder: 0;\n}\n.hd-footer-social .elementor-social-icon:hover { opacity: .75; }\n\n/* 6. Área táctil mínima en los enlaces de las listas. */\n.hd-footer .elementor-icon-list-item > a { min-height: 24px; }\n\n/* Crédito de autoría (Out. Studio) */\n#hd-credit a{color:inherit;text-decoration:none;transition:color .2s}\n#hd-credit a:hover{color:#fff}\n"
  },
