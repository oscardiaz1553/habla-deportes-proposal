  "page_settings": {
    "custom_css": "/* ===== Header Habla Deportes — CSS de la plantilla ===== */\n\n/* Franja principal: transparente sobre el hero, navy al hacer scroll (sticky).\n   Elementor Pro añade la clase .elementor-sticky--effects cuando la franja queda fija. */\n.hd-header-bar {\n\ttransition: background-color .25s ease, box-shadow .25s ease;\n}\n.hd-header-bar.elementor-sticky--effects {\n\tbackground-color: #294D6E !important;\n\tbackground-image: none !important;\n\tbox-shadow: 0 8px 24px rgba(23, 34, 46, .18);\n}\n@media (prefers-reduced-motion: reduce) {\n\t.hd-header-bar { transition: none; }\n}\n\n/* El menú no debe estirarse: ocupa lo que necesita, entre logo y botón. */\n.hd-header-bar .elementor-widget-nav-menu { flex: 0 1 auto; }\n\n/* Punto rojo del topbar (el markup vive en el widget HTML). */\n.hd-live-dot {\n\tdisplay: inline-block;\n\twidth: 9px;\n\theight: 9px;\n\tborder-radius: 50%;\n\tbackground: #D20000;\n\tflex: none;\n\tbox-shadow: 0 0 0 0 rgba(210, 0, 0, .55);\n\tanimation: hdLiveDot 2.4s ease-out infinite;\n}\n@keyframes hdLiveDot {\n\t0%   { box-shadow: 0 0 0 0 rgba(210, 0, 0, .55); }\n\t70%  { box-shadow: 0 0 0 7px rgba(210, 0, 0, 0); }\n\t100% { box-shadow: 0 0 0 0 rgba(210, 0, 0, 0); }\n}\n@media (prefers-reduced-motion: reduce) {\n\t.hd-live-dot { animation: none; }\n}\n"
  },
